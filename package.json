{
  "name": "logistics-cost-insight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "start:local": "node scripts/start-local.mjs",
    "release:build": "python3 scripts/build-release.py",
    "test": "node --test sales.test.mjs store-import.test.mjs periods.test.mjs tests.mjs excel.test.mjs domain.test.mjs server.test.mjs scripts/review.test.mjs",
    "admin:init": "node admin.mjs",
    "db:backup": "node backup-db.mjs",
    "test:backup": "python3 -m unittest discover -s deploy/backup -p \"test_*.py\" -v",
    "test:aws-costs": "python3 -m unittest discover -s deploy/aws -p \"test_*.py\" -v",
    "review:build": "node scripts/build-review.mjs",
    "review": "node scripts/review-server.mjs",
    "test:app": "python3 scripts/smoke-app.py",
    "test:review": "python3 scripts/smoke-review.py"
  },
  "dependencies": {
    "exceljs": "4.4.0"
  },
  "engines": {
    "node": ">=24"
  }
}
